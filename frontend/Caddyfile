{
	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}
}

{$APP_BASE_URL} {
	@backend path /api /api/* /docs /docs/* /redoc /openapi.json
	handle @backend {
		reverse_proxy api:8000
	}

	handle /assets/* {
		root * /srv/cyberflow
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/cyberflow
		try_files {path} /index.html
		file_server
	}
}
