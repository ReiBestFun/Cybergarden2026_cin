# --- Это короче локально (Ollama) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# --- А это через облако (Groq) ---
# Раскомментируйте ребят и закомментируйте верхние три строки, если хотите юзать Groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_твой_ключ_тут
# LLM_MODEL=llama-3.3-70b-versatile

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000