# Скопируйте в .env в корне репозитория. Адрес — без пути и завершающего слеша.
APP_BASE_URL=https://cyberflow.example.org
HTTP_PORT=80
HTTPS_PORT=443

# Для новой БД: openssl rand -hex 32. PostgreSQL на хосте доступен только через loopback.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Для каждого ключа отдельно: openssl rand -base64 32 | tr '+/' '-_'
# При переносе существующей базы сохраните оба прежних значения.
DATA_ENCRYPTION_KEY=
CREDENTIALS_ENCRYPTION_KEY=

# Из GitHub OAuth App, зарегистрированного для APP_BASE_URL
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Источники для ноды репозитория. Впишите свои разрешённые GitHub-репозитории.
ALLOWED_REPOSITORIES='["https://github.com/TBagirov/training"]'
LOG_DESTINATIONS='{"docker-archive":"/var/lib/cyberflow/logs"}'

# Локальная модель. Первый запуск скачивает модель в постоянный том.
# Для внешнего провайдера очистите COMPOSE_PROFILES и выберите модель в настройках команды.
COMPOSE_PROFILES=ollama
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen3.5:4b

# Для подключения чатов к серверному боту добавьте telegram в COMPOSE_PROFILES.
# Например, COMPOSE_PROFILES=ollama,telegram или COMPOSE_PROFILES=telegram.
TELEGRAM_BOT_TOKEN=

# Для почтовых уведомлений укажите SMTP и разрешённые адреса.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_RECIPIENTS='[]'
