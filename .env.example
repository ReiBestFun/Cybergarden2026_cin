# Для деплоя всего проекта через Docker Compose используйте deploy/env.example.
DATABASE_URL=postgresql+psycopg://workflow:workflow@127.0.0.1:5432/workflow
POSTGRES_PASSWORD=workflow
POSTGRES_PORT=5432
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ALLOWED_REPOSITORIES=["https://github.com/TBagirov/training"]
# true: принимать любой публичный GitHub-репозиторий (только для разработки)
ALLOW_ANY_REPOSITORY=false
REPOSITORY_TIMEOUT_SECONDS=60
SCAN_TIMEOUT_SECONDS=30
WORKER_POLL_SECONDS=1
WORKER_STALE_SECONDS=180
# SCA_CATALOG_PATH=/absolute/path/to/vulnerabilities.json
CI_WORKFLOW_TOKENS={}
# Generate a Fernet key once and share it with the API and worker.
CREDENTIALS_ENCRYPTION_KEY=

# GitHub login and private data in PostgreSQL
APP_BASE_URL=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DATA_ENCRYPTION_KEY=

# Optional log archives on POSIX mounts. Put the alias in .cyberflow-destination on its volume.
# LOG_DESTINATIONS={"team-archive":"/mnt/cyberflow-logs"}

# Notifications
NOTIFY_TIMEOUT_SECONDS=15
NOTIFY_POLL_SECONDS=1
NOTIFY_MAX_ATTEMPTS=4
NOTIFY_MAX_ATTACHMENT_BYTES=2097152
NOTIFY_EMAIL_RECIPIENTS=[]
# Optional server-wide restriction for verified Telegram destinations
NOTIFY_TELEGRAM_RECIPIENTS=[]
TELEGRAM_BOT_TOKEN=
# Telegram bot token from @BotFather
# SMTP; for development run `python -m backend.app.devtools.mail_sink` and use 127.0.0.1:1025 with SMTP_SECURITY=none
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=cyberflow@localhost

# AI report worker. For a hosted model use its HTTPS chat-completions base URL.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:4b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90
